# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Real environment variables win over anything set here.

# --- Kraken (only needed for --live) ---------------------------------------
# Create a key with trade permissions at https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Pushover (optional: push on fills) ------------------------------------
# Leave blank to disable. https://pushover.net
PUSHOVER_TOKEN=
PUSHOVER_USER=
PUSHOVER_SOUND=cashregister

# --- Blynk (optional: realized PnL to virtual pins) ------------------------
# Leave blank to disable. V0 = total, one pin per coin (see blynk_pin in COINS).
BLYNK_TOKEN=

# --- Web dashboard ---------------------------------------------------------
# Shared secret for the dashboard, which can place and cancel real orders.
# REQUIRED unless DASHBOARD_HOST is loopback -- the server refuses to start
# otherwise. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
# DASHBOARD_HOST=0.0.0.0     # 127.0.0.1 to bind loopback only (use an SSH tunnel)
# DASHBOARD_PORT=8787
